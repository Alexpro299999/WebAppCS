@page
@model MyWebApp.Pages.Dynamic.DataModel
@{
    ViewData["Title"] = Model.CurrentEntity?.Name ?? "Данные таблиц";
    bool isEditMode = Model.EditRecordId.HasValue;
}

@if (Model.CurrentEntity == null)
{
    <div class="max-w-7xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">Выберите таблицу для просмотра данных</h2>
        @if (Model.AllEntities != null && Model.AllEntities.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
                @foreach (var ent in Model.AllEntities)
                {
                    <a href="/Dynamic/Data?entityId=@ent.Id" class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow flex flex-col items-center justify-center text-center h-32 group">
                        <div class="mb-3 p-3 bg-emerald-50 rounded-full group-hover:bg-emerald-100 transition-colors">
                            <i class="fa-solid fa-table text-2xl text-emerald-600"></i>
                        </div>
                        <span class="font-semibold text-gray-700 group-hover:text-emerald-700 transition-colors">@ent.Name</span>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-r shadow-sm">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <i class="fas fa-exclamation-triangle text-yellow-400"></i>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-yellow-700">
                            Нет созданных таблиц. 
                            <a href="/Dynamic/Schema" class="font-medium underline hover:text-yellow-600">Перейдите в Конструктор</a>, чтобы создать первую таблицу.
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="max-w-7xl mx-auto">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-gray-800">@Model.CurrentEntity.Name</h2>
            <div class="flex gap-2">
                 <a href="/Dynamic/Data" class="bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-50 transition-colors text-sm font-medium shadow-sm">
                     <i class="fa-solid fa-arrow-left mr-1"></i> Все таблицы
                 </a>
                 <a href="/Dynamic/Schema" class="bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-50 transition-colors text-sm font-medium shadow-sm">
                     <i class="fa-solid fa-pen-to-square mr-1"></i> Схема
                 </a>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8 @(isEditMode ? "ring-2 ring-emerald-500" : "")">
            <h5 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">
                @if (isEditMode)
                {
                    <i class="fa-solid fa-pen text-emerald-600"></i> <span>Редактирование записи #@Model.EditRecordId</span>
                }
                else
                {
                    <i class="fa-solid fa-plus-circle text-emerald-600"></i> <span>Добавить запись</span>
                }
            </h5>
            
            <form method="post" asp-page-handler="SaveRecord">
                <input type="hidden" name="entityId" value="@Model.CurrentEntity.Id" />
                @if (isEditMode)
                {
                    <input type="hidden" name="recordId" value="@Model.EditRecordId" />
                }

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    @foreach (var attr in Model.CurrentEntity.Attributes)
                    {
                        string currentVal = isEditMode && Model.EditValues.ContainsKey(attr.Id) ? Model.EditValues[attr.Id] : "";

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">@attr.Name</label>

                            @if (attr.DataType == "date")
                            {
                                <input type="date" name="values[@attr.Id]" value="@currentVal" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                            }
                            else if (attr.DataType == "number")
                            {
                                <input type="number" step="any" name="values[@attr.Id]" value="@currentVal" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                            }
                            else if (attr.DataType == "bool")
                            {
                                <select name="values[@attr.Id]" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                                    <!option value="false" @(currentVal == "false" ? "selected" : "")>Нет</!option>
                                    <!option value="true" @(currentVal == "true" ? "selected" : "")>Да</!option>
                                </select>
                            }
                            else if (attr.DataType == "relation" && attr.LinkedEntityId.HasValue)
                            {
                                <select name="values[@attr.Id]" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                                    <option value="">-- Выберите --</option>
                                    @if (Model.LookupValues.ContainsKey(attr.LinkedEntityId.Value))
                                    {
                                        foreach (var item in Model.LookupValues[attr.LinkedEntityId.Value])
                                        {
                                            <!option value="@item.Key" @(currentVal == item.Key.ToString() ? "selected" : "")>@item.Value</!option>
                                        }
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="text" name="values[@attr.Id]" value="@currentVal" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                            }
                        </div>
                    }
                </div>
                <div class="mt-6 flex gap-3">
                    <button type="submit" class="bg-emerald-600 text-white px-6 py-2 rounded-lg hover:bg-emerald-700 transition-colors font-medium shadow-sm">
                        <i class="fa-solid fa-save mr-1"></i> Сохранить
                    </button>
                    @if (isEditMode)
                    {
                        <a href="/Dynamic/Data?entityId=@Model.CurrentEntity.Id" class="bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300 transition-colors font-medium">
                            Отмена
                        </a>
                    }
                </div>
            </form>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                        @foreach (var attr in Model.CurrentEntity.Attributes)
                        {
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">@attr.Name</th>
                        }
                        <th class="px-6 py-3 text-right"></th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var record in Model.Records)
                    {
                        <tr class="hover:bg-gray-50 transition-colors @(Model.EditRecordId == record.Id ? "bg-emerald-50" : "")">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@record.Id</td>
                            @foreach (var attr in Model.CurrentEntity.Attributes)
                            {
                                var val = record.Values.FirstOrDefault(v => v.EavAttributeId == attr.Id)?.Value;

                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    @if (attr.DataType == "bool")
                                    {
                                        <span class="@(val == "true" ? "text-emerald-700 bg-emerald-100 border border-emerald-200" : "text-gray-600 bg-gray-100 border border-gray-200") px-2.5 py-0.5 rounded-full text-xs font-medium">
                                            @(val == "true" ? "Да" : "Нет")
                                        </span>
                                    }
                                    else if (attr.DataType == "relation" && attr.LinkedEntityId.HasValue && val != null && int.TryParse(val, out int refId))
                                    {
                                        if (Model.LookupValues.ContainsKey(attr.LinkedEntityId.Value) && Model.LookupValues[attr.LinkedEntityId.Value].ContainsKey(refId))
                                        {
                                            <a href="/Dynamic/Data?entityId=@attr.LinkedEntityId" class="text-blue-600 hover:text-blue-800 hover:underline flex items-center gap-1">
                                                <i class="fa-solid fa-link text-xs"></i>
                                                @Model.LookupValues[attr.LinkedEntityId.Value][refId]
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400 italic">ID: @val (не найдено)</span>
                                        }
                                    }
                                    else
                                    {
                                        @val
                                    }
                                </td>
                            }
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a href="/Dynamic/Data?entityId=@Model.CurrentEntity.Id&editRecordId=@record.Id" class="text-emerald-600 hover:text-emerald-900 mr-3 p-1 inline-block" title="Редактировать">
                                    <i class="fa-solid fa-pencil"></i>
                                </a>
                                <form method="post" asp-page-handler="DeleteRecord" class="inline" onsubmit="return confirm('Удалить эту запись безвозвратно?');">
                                    <input type="hidden" name="recordId" value="@record.Id" />
                                    <input type="hidden" name="entityId" value="@Model.CurrentEntity.Id" />
                                    <button class="text-red-400 hover:text-red-600 transition-colors p-1" title="Удалить">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Records.Any())
            {
                <div class="p-8 text-center text-gray-500">
                    <i class="fa-solid fa-inbox text-4xl mb-3 text-gray-300"></i>
                    <p>Записей пока нет</p>
                </div>
            }
        </div>
    </div>
}