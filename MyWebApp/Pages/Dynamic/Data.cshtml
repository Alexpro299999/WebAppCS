@page
@model MyWebApp.Pages.Dynamic.DataModel
@{
    ViewData["Title"] = Model.Entity?.Name ?? "Данные";
}

<div class="max-w-6xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <div class="flex items-center gap-4">
            <h2 class="text-2xl font-bold text-gray-800">Данные:</h2>
            <form method="get">
                <select name="entityId" onchange="this.form.submit()" class="text-lg font-bold text-emerald-700 bg-transparent border-none focus:ring-0 cursor-pointer py-0 pl-0 pr-8">
                    @foreach (var ent in Model.AllEntities)
                    {
                        <!option value="@ent.Id" @(Model.Entity?.Id == ent.Id ? "selected" : "")>@ent.Name</!option>
                    }
                </select>
            </form>
        </div>
        <a href="/Dynamic/Schema" class="text-gray-500 hover:text-gray-700">← Редактор таблиц</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 text-red-700 text-sm rounded shadow-sm">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Entity != null)
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8">
            <h5 class="text-lg font-semibold text-gray-700 mb-4">Добавить запись в "@Model.Entity.Name"</h5>
            <form method="post" asp-page-handler="AddRecord">
                <input type="hidden" name="entityId" value="@Model.Entity.Id" />
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var attr in Model.Entity.Attributes)
                    {
                        <div class="flex flex-col">
                            <label class="text-sm font-medium text-gray-700 mb-1">@attr.Name</label>

                            @if (attr.DataType == "relation" && Model.RelationOptions.ContainsKey(attr.Id))
                            {
                                <select name="relations[@attr.Id]" class="rounded-lg border-gray-300 focus:border-emerald-500 focus:ring-emerald-500 text-sm">
                                    <option value="">-- Не выбрано --</option>
                                    @foreach (var opt in Model.RelationOptions[attr.Id])
                                    {
                                        <option value="@opt.Value">@opt.Text</option>
                                    }
                                </select>
                            }
                            else if (attr.DataType == "bool")
                            {
                                <select name="values[@attr.Id]" class="rounded-lg border-gray-300 focus:border-emerald-500 focus:ring-emerald-500 text-sm">
                                    <option value="false">Нет</option>
                                    <option value="true">Да</option>
                                </select>
                            }
                            else if (attr.DataType == "date")
                            {
                                <input type="date" name="values[@attr.Id]" class="rounded-lg border-gray-300 focus:border-emerald-500 focus:ring-emerald-500 text-sm" />
                            }
                            else if (attr.DataType == "number")
                            {
                                <input type="number" step="any" name="values[@attr.Id]" class="rounded-lg border-gray-300 focus:border-emerald-500 focus:ring-emerald-500 text-sm" />
                            }
                            else
                            {
                                <input type="text" name="values[@attr.Id]" class="rounded-lg border-gray-300 focus:border-emerald-500 focus:ring-emerald-500 text-sm" />
                            }
                        </div>
                    }
                </div>
                <button type="submit" class="mt-4 bg-emerald-600 text-white px-4 py-2 rounded-lg hover:bg-emerald-700 transition-colors font-medium text-sm">Добавить</button>
            </form>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-600">
                    <thead class="bg-gray-50 text-xs uppercase font-semibold text-gray-500">
                        <tr>
                            <th class="px-6 py-4">ID</th>
                            @foreach (var attr in Model.Entity.Attributes)
                            {
                                <th class="px-6 py-4">@attr.Name</th>
                            }
                            <th class="px-6 py-4 text-right">Действия</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var record in Model.Records)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4">@record.Id</td>
                                @foreach (var attr in Model.Entity.Attributes)
                                {
                                    var val = record.Values.FirstOrDefault(v => v.EavAttributeId == attr.Id);
                                    <td class="px-6 py-4">
                                        @if (attr.DataType == "relation")
                                        {
                                            if (val?.LinkedRecord != null)
                                            {
                                                <span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded text-xs">
                                                    @Model.GetRecordDisplayName(val.LinkedRecord)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-gray-400">-</span>
                                            }
                                        }
                                        else if (attr.DataType == "bool")
                                        {
                                            @(val?.Value == "true" ? "Да" : "Нет")
                                        }
                                        else
                                        {
                                            @(val?.Value ?? "-")
                                        }
                                    </td>
                                }
                                <td class="px-6 py-4 text-right flex justify-end gap-2">
                                    <a href="/Dynamic/EditRecord?id=@record.Id&entityId=@Model.Entity.Id" class="text-blue-500 hover:text-blue-700 font-medium">Изм.</a>

                                    <form method="post" asp-page-handler="DeleteRecord" onsubmit="return confirm('Удалить запись?');">
                                        <input type="hidden" name="id" value="@record.Id" />
                                        <input type="hidden" name="entityId" value="@Model.Entity.Id" />
                                        <button class="text-red-500 hover:text-red-700 font-medium">Удал.</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.Records.Any())
                {
                    <div class="p-8 text-center text-gray-400">Нет записей</div>
                }
            </div>
        </div>
    }
</div>