@page
@model MyWebApp.Pages.Dynamic.DataModel
@{
    ViewData["Title"] = Model.CurrentEntity?.Name ?? "Данные";
}

@if (Model.CurrentEntity == null)
{
    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4">
        <p class="text-sm text-yellow-700">Таблица не найдена.</p>
    </div>
}
else
{
    <div class="max-w-7xl mx-auto">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-gray-800">@Model.CurrentEntity.Name</h2>
            <a href="/Dynamic/Schema" class="bg-gray-200 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-300 transition-colors text-sm font-medium">К схемам</a>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-8">
            <h5 class="text-lg font-semibold text-gray-700 mb-4">Добавить запись</h5>
            <form method="post" asp-page-handler="SaveRecord">
                <input type="hidden" name="entityId" value="@Model.CurrentEntity.Id" />
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    @foreach (var attr in Model.CurrentEntity.Attributes)
                    {
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">@attr.Name</label>

                            @if (attr.DataType == "date")
                            {
                                <input type="date" name="values[@attr.Id]" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                            }
                            else if (attr.DataType == "number")
                            {
                                <input type="number" step="any" name="values[@attr.Id]" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                            }
                            else if (attr.DataType == "bool")
                            {
                                <select name="values[@attr.Id]" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                                    <option value="false">Нет</option>
                                    <option value="true">Да</option>
                                </select>
                            }
                            else if (attr.DataType == "relation" && attr.LinkedEntityId.HasValue)
                            {
                                <select name="values[@attr.Id]" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500">
                                    <option value="">-- Выберите --</option>
                                    @if (Model.LookupValues.ContainsKey(attr.LinkedEntityId.Value))
                                    {
                                        foreach (var item in Model.LookupValues[attr.LinkedEntityId.Value])
                                        {
                                            <option value="@item.Key">@item.Value</option>
                                        }
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="text" name="values[@attr.Id]" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" />
                            }
                        </div>
                    }
                </div>
                <div class="mt-6">
                    <button type="submit" class="bg-emerald-600 text-white px-6 py-2 rounded-lg hover:bg-emerald-700 transition-colors font-medium">Сохранить</button>
                </div>
            </form>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                        @foreach (var attr in Model.CurrentEntity.Attributes)
                        {
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">@attr.Name</th>
                        }
                        <th class="px-6 py-3 text-right"></th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var record in Model.Records)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@record.Id</td>
                            @foreach (var attr in Model.CurrentEntity.Attributes)
                            {
                                var val = record.Values.FirstOrDefault(v => v.EavAttributeId == attr.Id)?.Value;

                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    @if (attr.DataType == "bool")
                                    {
                                        <span class="@(val == "true" ? "text-green-600 bg-green-100" : "text-gray-600 bg-gray-100") px-2 py-1 rounded text-xs">
                                            @(val == "true" ? "Да" : "Нет")
                                        </span>
                                    }
                                    else if (attr.DataType == "relation" && attr.LinkedEntityId.HasValue && val != null && int.TryParse(val, out int refId))
                                    {
                                        // Try to find display text in loaded lookups
                                        if (Model.LookupValues.ContainsKey(attr.LinkedEntityId.Value) && Model.LookupValues[attr.LinkedEntityId.Value].ContainsKey(refId))
                                        {
                                            <a href="/Dynamic/Data?entityId=@attr.LinkedEntityId" class="text-blue-600 hover:underline">
                                                @Model.LookupValues[attr.LinkedEntityId.Value][refId]
                                            </a>
                                        }
                                        else
                                        {
                                            <span>ID: @val</span>
                                        }
                                    }
                                    else
                                    {
                                        @val
                                    }
                                </td>
                            }
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <form method="post" asp-page-handler="DeleteRecord" class="inline" onsubmit="return confirm('Удалить?');">
                                    <input type="hidden" name="recordId" value="@record.Id" />
                                    <input type="hidden" name="entityId" value="@Model.CurrentEntity.Id" />
                                    <button class="text-red-600 hover:text-red-900">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}