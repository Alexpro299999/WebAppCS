@page
@model MyWebApp.Pages.ClientsModel
@using MyWebApp.Models
@{
    ViewData["Title"] = "Клиенты";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people text-primary me-2"></i> @ViewData["Title"]</h2>
</div>
@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusMessage.StartsWith("Ошибка") ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Список клиентов</h5>
        <a asp-page="AddEditClient" class="btn btn-success btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Добавить клиента
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle">
                <thead>
                    <tr>
                        <th><i class="bi bi-image"></i> Фото</th>
                        <th><i class="bi bi-person"></i> ФИО</th>
                        <th><i class="bi bi-telephone"></i> Телефон</th>
                        <th><i class="bi bi-gear"></i> Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.Clients)
                    {
                        <tr>
                            <td>
                                <img src="@(client.Photo != null ? $"data:image/jpeg;base64,{Convert.ToBase64String(client.Photo)}" : "/default-avatar.jpeg")"
                                     alt="@client.Fio" style="width:80px; height:80px; object-fit:cover; border-radius:50%;" />
                            </td>
                            <td><strong>@client.Fio</strong></td>
                            <td>
                                <a class="text-decoration-none">
                                    <i class="bi bi-telephone me-1"></i> @client.Phone
                                </a>
                            </td>
                            <td>
                                <a asp-page="AddEditClient" asp-route-id="@client.ClientId" class="btn btn-primary btn-sm me-1">
                                    <i class="bi bi-pencil"></i> Изменить
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@client.ClientId" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Удалить клиента?');">
                                        <i class="bi bi-trash"></i> Удалить
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>