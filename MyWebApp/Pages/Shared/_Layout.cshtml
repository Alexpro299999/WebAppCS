<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - МедОсмотр Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
        }

        .input-validation-error {
            border-color: #ef4444 !important;
        }

        .field-validation-error {
            color: #ef4444;
            font-size: 0.75rem;
            margin-top: 0.25rem;
            display: block;
        }
    </style>
</head>
<body class="text-gray-800 h-screen flex overflow-hidden">

    <aside class="w-64 bg-white border-r border-gray-200 flex-shrink-0 hidden md:flex flex-col z-20">
        <div class="h-16 flex items-center px-6 border-b border-gray-100">
            <div class="text-emerald-600 text-2xl font-bold flex items-center gap-2">
                <i class="fa-solid fa-heart-pulse"></i>
                <span>МедОсмотр</span>
            </div>
        </div>
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
            <a asp-page="/Index" class="w-full flex items-center px-3 py-2.5 text-sm font-medium rounded-lg text-gray-600 hover:bg-gray-50 transition-colors group">
                <i class="fa-solid fa-chart-pie w-6 text-center mr-2 text-lg text-gray-400 group-hover:text-gray-500"></i>
                Дашборд
            </a>

            <div class="pt-4 pb-2 px-3 text-xs font-semibold text-gray-400 uppercase tracking-wider">Реестры</div>

            <a asp-page="/Clients" class="w-full flex items-center px-3 py-2.5 text-sm font-medium rounded-lg text-gray-600 hover:bg-gray-50 transition-colors group">
                <i class="fa-solid fa-users w-6 text-center mr-2 text-lg text-gray-400 group-hover:text-gray-500"></i>
                Клиенты
            </a>
            <a asp-page="/Employees" class="w-full flex items-center px-3 py-2.5 text-sm font-medium rounded-lg text-gray-600 hover:bg-gray-50 transition-colors group">
                <i class="fa-solid fa-user-doctor w-6 text-center mr-2 text-lg text-gray-400 group-hover:text-gray-500"></i>
                Сотрудники
            </a>

            <div class="pt-4 pb-2 px-3 text-xs font-semibold text-gray-400 uppercase tracking-wider">Медицина</div>

            <a asp-page="/Procedures" class="w-full flex items-center px-3 py-2.5 text-sm font-medium rounded-lg text-gray-600 hover:bg-gray-50 transition-colors group">
                <i class="fa-solid fa-list-check w-6 text-center mr-2 text-lg text-gray-400 group-hover:text-gray-500"></i>
                Виды услуг
            </a>
            <a asp-page="/MedicalExams" class="w-full flex items-center px-3 py-2.5 text-sm font-medium rounded-lg text-gray-600 hover:bg-gray-50 transition-colors group">
                <i class="fa-solid fa-file-medical w-6 text-center mr-2 text-lg text-gray-400 group-hover:text-gray-500"></i>
                Освидетельствования
            </a>
            <a asp-page="/Reviews" class="w-full flex items-center px-3 py-2.5 text-sm font-medium rounded-lg text-gray-600 hover:bg-gray-50 transition-colors group">
                <i class="fa-solid fa-comment-medical w-6 text-center mr-2 text-lg text-gray-400 group-hover:text-gray-500"></i>
                Отзывы
            </a>

            <div class="pt-4 pb-2 px-3 text-xs font-semibold text-gray-400 uppercase tracking-wider">Администрирование</div>

            <a asp-page="/Dynamic/Schema" class="w-full flex items-center px-3 py-2.5 text-sm font-medium rounded-lg text-gray-600 hover:bg-gray-50 transition-colors group">
                <i class="fa-solid fa-table-columns w-6 text-center mr-2 text-lg text-gray-400 group-hover:text-gray-500"></i>
                Конструктор таблиц
            </a>
            <a asp-page="/Dynamic/Data" class="w-full flex items-center px-3 py-2.5 text-sm font-medium rounded-lg text-gray-600 hover:bg-gray-50 transition-colors group">
                <i class="fa-solid fa-database w-6 text-center mr-2 text-lg text-gray-400 group-hover:text-gray-500"></i>
                Данные таблиц
            </a>

        </nav>
        <div class="p-4 border-t border-gray-200">
            <div class="flex items-center gap-3">
                <img src="https://ui-avatars.com/api/?name=Admin+User&background=10b981&color=fff" class="h-9 w-9 rounded-full" alt="Admin">
                <div>
                    <p class="text-sm font-medium text-gray-700">Администратор</p>
                    <p class="text-xs text-gray-500">Главный врач</p>
                </div>
            </div>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-4 sm:px-6 lg:px-8 md:hidden">
            <div class="text-emerald-600 text-xl font-bold flex items-center gap-2">
                <i class="fa-solid fa-heart-pulse"></i> МедОсмотр
            </div>
            <button onclick="document.querySelector('aside').classList.toggle('hidden'); document.querySelector('aside').classList.toggle('absolute'); document.querySelector('aside').classList.toggle('h-full');" class="text-gray-500 hover:text-gray-700">
                <i class="fa-solid fa-bars text-xl"></i>
            </button>
        </header>

        <main class="flex-1 overflow-y-auto bg-gray-50 p-4 sm:p-8">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>