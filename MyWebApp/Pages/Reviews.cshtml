@page
@model MyWebApp.Pages.ReviewsModel
@using MyWebApp.Models
@{
    ViewData["Title"] = "Отзывы клиентов";
}
@{
    var reviewsByProcedure = Model.Reviews
        .GroupBy(r => r.Procedure)
        .OrderBy(g => g.Key.Name)
        .ToList();
}
<div class="container mt-4">
    <h2 class="mb-4">
        <i class="bi bi-chat-left-text text-warning me-2"></i> @ViewData["Title"]
    </h2>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.StatusMessage.StartsWith("Ошибка") ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-end mb-3">
        <a asp-page="AddEditReview" class="btn btn-success"> 
            <i class="bi bi-plus-circle me-1"></i> Добавить отзыв
        </a>
    </div>

    @if (reviewsByProcedure.Any())
    {
        <div class="accordion" id="procedureAccordion">
            @for (int i = 0; i < reviewsByProcedure.Count; i++)
            {
                var group = reviewsByProcedure[i];
                var collapseId = $"collapse{i}";
                var headingId = $"heading{i}";
                var isExpanded = Model.SelectedProcedureId.HasValue && Model.SelectedProcedureId.Value == group.Key.ProcedureId;
                var collapseClass = isExpanded ? "accordion-collapse collapse show" : "accordion-collapse collapse";
                var buttonClass = isExpanded ? "accordion-button" : "accordion-button collapsed";
                <div class="accordion-item">
                    <h2 class="accordion-header" id="@headingId">
                        <button class="@buttonClass" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@isExpanded" aria-controls="@collapseId">
                            <strong>@group.Key.Name</strong>
                        </button>
                    </h2>
                    <div id="@collapseId" class="@collapseClass" aria-labelledby="@headingId" data-bs-parent="#procedureAccordion">
                        <div class="accordion-body">
                            @foreach (var review in group)
                            {
                                <div class="mb-3 border-bottom pb-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong>@review.Client.Fio</strong>
                                        <div>
                                            <a asp-page="AddEditReview" asp-route-id="@review.ReviewId" class="btn btn-primary btn-sm me-1">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@review.ReviewId" class="d-inline">
                                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Удалить отзыв?');">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                    <div class="text-warning">
                                        @for (int j = 0; j < review.Rating; j++)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        @for (int j = review.Rating; j < 5; j++)
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    </div>
                                    <p class="mb-0">
                                        @if (!string.IsNullOrEmpty(review.Comment))
                                        {
                                            @review.Comment
                                        }
                                        else
                                        {
                                            <span class="text-muted">Без комментария</span>
                                        }
                                    </p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle display-4"></i>
            <h4>Отзывов пока нет</h4>
            <p>Будьте первым, кто оставит отзыв!</p>
            <a asp-page="AddEditReview" class="btn btn-primary">Оставить отзыв</a>
        </div>
    }
</div>