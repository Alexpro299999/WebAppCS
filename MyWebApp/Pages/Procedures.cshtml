@page
@model MyWebApp.Pages.ProceduresModel
@using MyWebApp.Models
@{
    ViewData["Title"] = "Процедуры";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-scissors text-success me-2"></i> @ViewData["Title"]</h2>
    <a asp-page="AddEditProcedure" class="btn btn-success btn-sm"> 
        <i class="bi bi-plus-circle me-1"></i> Добавить процедуру
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusMessage.StartsWith("Ошибка") ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Название</th>
                        <th>Цена</th>
                        <th>Отзывы</th>
                        <th><i class="bi bi-gear"></i> Действия</th> 
                    </tr>
                </thead>
                <tbody>
                    @foreach (var procedure in Model.Procedures)
                    {
                        <tr>
                            <td>
                                <i class="bi bi-scissors text-success me-1"></i>
                                @procedure.Name
                            </td>
                            <td>
                                <span class="text-primary fw-bold">@procedure.Price.ToString("N2") руб.</span>
                            </td>
                            <td>
                                <a class="text-decoration-none" href="@Url.Page("/Reviews", new { procedureId = procedure.ProcedureId })">
                                    <i class="bi bi-chat-left-text text-warning me-1"></i>
                                    @procedure.Reviews.Count
                                </a>
                            </td>
                            <td>
                                <a asp-page="AddEditProcedure" asp-route-id="@procedure.ProcedureId" class="btn btn-primary btn-sm me-1">
                                    <i class="bi bi-pencil"></i> Изменить
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@procedure.ProcedureId" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Удалить процедуру?');">
                                        <i class="bi bi-trash"></i> Удалить
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>